# Modèle de configuration — COPIER en `.env` puis remplir (le `.env` réel n'est jamais commité).
# En production, ces variables se mettent dans Netlify → Site configuration → Environment variables.

# --- Supabase (Tranche 2) ---
# Project Settings → API
SUPABASE_URL=
# Clé `service_role` (ou Secret key sb_secret_...) — SECRÈTE, serveur uniquement, bypass RLS
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI (Tranche 4) ---
# platform.openai.com → API keys (sk-...)
OPENAI_API_KEY=
# Modèle de génération (sortie structurée json_schema). À ajuster selon le catalogue courant.
OPENAI_MODEL=gpt-6.1-sol

# --- Resend (Tranche 4) ---
# resend.com → API Keys (re_...)
RESEND_API_KEY=
# Expéditeur sur le domaine vérifié. Format complet « Nom <adresse> » ou adresse seule.
# Ex. : MIRA <contact@mira-audit.fr>
RESEND_FROM=
# Optionnel : boîte qui reçoit les réponses des prospects (sinon → l'adresse RESEND_FROM).
# Ex. : moetez@polaria.ai
RESEND_REPLY_TO=
# Optionnel mais fortement conseillé en prod : email interne des alertes ops (génération en
# échec, rapport parti à relire avec des contrôles bloquants, demande non enregistrée).
# Vide → les incidents ne sont visibles que dans les logs des functions.
OPS_EMAIL=
# Optionnel : copie cachée (CCI) de chaque rapport envoyé au prospect, PDF compris.
# Une ou plusieurs adresses séparées par des virgules. Vide → pas de CCI.
# Ex. : moetez@polaria.ai,autre@polaria.ai
REPORT_BCC_EMAIL=
